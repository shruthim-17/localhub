# Local MongoDB default: mongodb://127.0.0.1:27017/localhub
MONGODB_URI=mongodb://127.0.0.1:27017/localhub
MONGODB_DB=localhub
PORT=3000
# Set true only when intentionally testing without MongoDB
USE_IN_MEMORY=false

# Resend email OTP configuration. Use a verified sender address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudinary server-side upload configuration.
CLOUDINARY_CLOUD_NAME=hwnz3nty
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
